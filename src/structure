private State backTrack(State currentState) {
    while (currentState != null && currentState.getTime() > totalTime) {
        State parentState = currentState.getFather();
        ArrayList<State> children = parentState.getChildren();

        // Remove currentState from the children
        children.remove(currentState);

        if (children.isEmpty()) {
            // If there are no more children, continue backtracking
            currentState = parentState;
        } else {
            // If there are remaining children, select the next one
            State newState = getMinStateQueue(children);
            newState.setFather(parentState);
            currentState = newState;
        }
    }

    return currentState;
}
